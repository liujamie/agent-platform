# ===========================================
# Agent Platform — 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并根据实际环境修改:
#   cp .env.example .env
# ===========================================

# --- 应用服务 ---
HOST=0.0.0.0
PORT=8000

# --- 模型 API Key (至少配置一个) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DASHSCALE_API_KEY=your-dashscope-api-key

# --- 模型配置 (可选) ---
DEFAULT_MODEL=deepseek-chat
DEFAULT_MODEL_API_BASE=https://api.deepseek.com

# --- MySQL (Docker Compose 下用服务名) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=agent_platform

# --- Redis (Docker Compose 下用服务名) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
